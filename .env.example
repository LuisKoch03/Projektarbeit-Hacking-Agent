# Lokales Ollama benötigt keinen API-Key.
PROVIDER=ollama
BASE_URL=http://localhost:11434/v1
API_KEY=
# Leer lassen für die interaktive Modellauswahl.
MODEL=
TEMPERATURE=0.0

# Lokaler API-Schluessel fuer den OWASP-ZAP-Container.
ZAP_API_KEY=change-me
ZAP_BASE_URL=http://127.0.0.1:8090
# Exakte, durch Kommas getrennte Hostnamen. Nur autorisierte Ziele eintragen.
ZAP_ALLOWED_HOSTS=host.docker.internal,localhost,127.0.0.1
